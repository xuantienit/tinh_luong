# Chọn resend hoặc sendgrid để bật gửi email thật.
AURORA_EMAIL_PROVIDER=disabled
AURORA_EMAIL_API_KEY=
AURORA_EMAIL_FROM=

# Ánh xạ ID nhân viên trong database sang email nhận lương.
# Ví dụ: {"2":"giao.vien@example.com","3":"nhan.vien@example.com"}
AURORA_STAFF_EMAILS_JSON={}

# Chỉ dùng cho demo local; để 0 khi chạy bình thường.
AURORA_DEMO_RESET=0
